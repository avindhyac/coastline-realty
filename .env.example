# Public URL used by Payload/Next for CORS, links, previews, and metadata.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Postgres connection string (Vercel Postgres/Neon/Supabase/etc.)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Generate strong random secrets for production.
PAYLOAD_SECRET=replace-with-a-random-secret
PREVIEW_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-a-random-secret

# Required on Vercel for persistent Payload media uploads.
# Create via Vercel Storage > Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
