# Public URL used by Payload/Next for CORS, links, previews, and metadata.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database selector. Use `prod` for real content, `dev` for a separate dev/staging database.
DATABASE_TARGET=prod

# Postgres connection strings (Vercel Postgres/Neon/Supabase/etc.)
DATABASE_URL_PROD=postgres://USER:PASSWORD@PROD_HOST:PORT/DATABASE?sslmode=require
DATABASE_URL_DEV=postgres://USER:PASSWORD@DEV_HOST:PORT/DATABASE?sslmode=require

# Optional single-URL fallback / override.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Generate strong random secrets for production.
PAYLOAD_SECRET=replace-with-a-random-secret
PREVIEW_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-a-random-secret

# Required on Vercel for persistent Payload media uploads.
# Create via Vercel Storage > Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
